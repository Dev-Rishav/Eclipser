					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Response has success true\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"});",
									"",
									"pm.test(\"Problem created with correct data\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('_id');",
									"    pm.expect(jsonData.data.title).to.eql('Two Sum');",
									"    pm.expect(jsonData.data.difficulty).to.eql('Easy');",
									"});",
									"",
									"// Store problem ID for later use",
									"if (pm.response.code === 201) {",
									"    const jsonData = pm.response.json();",
									"    pm.collectionVariables.set('PROBLEM_ID', jsonData.data._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"title\": \"Two Sum\",\n  \"description\": \"Given an array of integers nums and an integer target, return indices of the two numbers such that they add up to target.\\n\\nYou may assume that each input would have exactly one solution, and you may not use the same element twice.\\n\\nYou can return the answer in any order.\",\n  \"difficulty\": \"Easy\",\n  \"tags\": [\"Array\", \"Hash Table\"],\n  \"constraints\": \"2 <= nums.length <= 10^4\\n-10^9 <= nums[i] <= 10^9\\n-10^9 <= target <= 10^9\\nOnly one valid answer exists.\",\n  \"inputFormat\": \"First line contains space-separated integers representing the array.\\nSecond line contains the target integer.\",\n  \"outputFormat\": \"Two space-separated integers representing the indices of the two numbers.\",\n  \"sampleInput\": \"2 7 11 15\\n9\",\n  \"sampleOutput\": \"0 1\",\n  \"explanation\": \"Because nums[0] + nums[1] == 9, we return [0, 1].\",\n  \"testCases\": [\n    {\n      \"input\": \"2 7 11 15\\n9\",\n      \"expectedOutput\": \"0 1\",\n      \"isHidden\": false,\n      \"points\": 1\n    },\n    {\n      \"input\": \"3 2 4\\n6\",\n      \"expectedOutput\": \"1 2\",\n      \"isHidden\": false,\n      \"points\": 1\n    },\n    {\n      \"input\": \"3 3\\n6\",\n      \"expectedOutput\": \"0 1\",\n      \"isHidden\": true,\n      \"points\": 1\n    }\n  ],\n  \"timeLimit\": 2,\n  \"memoryLimit\": 128,\n  \"supportedLanguages\": [\"javascript\", \"java\"],\n  \"createdBy\": \"{{USER_ID}}\"\n}"
						},
						"url": {
							"raw": "{{BASE_URL}}/api/problems",
							"host": [
								"{{BASE_URL}}"
							],
							"path": [
								"api",
								"problems"
							]
						},
